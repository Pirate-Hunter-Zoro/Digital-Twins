# =============================================================================
# short_pipeline overrides
# -----------------------------------------------------------------------------
# Sourced by EVERY slurm_jobs/short_pipeline/*.sbatch, AFTER the real .env, with
# `set -a` so these values EXPORT into the environment and win over the .env
# values in the shell. Every load_dotenv() call in this repo uses the default
# override=False, so Python will NOT clobber these once they are already set in
# the environment. The real .env on disk is never modified.
#
# Purpose: run the TRD-prediction pipeline on the c3_short partition (9h wall)
# with LLM judging OFF, writing every artifact into an ISOLATED sandbox so the
# live neighbor-judging run's artifacts (and its pending analysis) are untouched.
# =============================================================================

# --- Force LLM judging + the extra (non-nearest) neighbor schemes off ---
# With COMPUTE_LLM_SIMILARITY=0 there is no vLLM server, no sharding, and no
# judgements merge. The nearest-neighbor cosine/uniform predictors and the
# classical-ML lineup still run and still produce ROC/PR/calibration results.
COMPUTE_LLM_SIMILARITY=0
NEIGHBOR_FARTHEST=0
NEIGHBOR_SUBSAMPLE=0

# --- Redirect all ARTIFACTS_DIR-derived outputs into an isolated sandbox ---
# ANALYSIS_DIR, EMBEDDER_MODEL_NAME and VLLM_MODEL_NAME come from the real .env
# (already sourced above). To test a DIFFERENT encoder, override
# EMBEDDER_MODEL_NAME / EMBEDDER_MODEL_PATH here too (uncomment below) and the
# EMBEDDINGS_DIR/RESULTS_DIR paths will follow automatically.
# EMBEDDER_MODEL_NAME="some-other-encoder"
# EMBEDDER_MODEL_PATH="${ANALYSIS_DIR}/models/${EMBEDDER_MODEL_NAME}"
ARTIFACTS_DIR="${ANALYSIS_DIR}/artifacts_short"
NARRATIVES_DIR="${ARTIFACTS_DIR}/deterministic_narratives"
FEATURE_DATAFRAME_PATH="${ARTIFACTS_DIR}/feature_vectors.parquet"
EMBEDDINGS_DIR="${ARTIFACTS_DIR}/${EMBEDDER_MODEL_NAME}"
JUDGEMENTS_DIR="${ARTIFACTS_DIR}/${VLLM_MODEL_NAME}"
RESULTS_DIR="${ARTIFACTS_DIR}/${EMBEDDER_MODEL_NAME}/${VLLM_MODEL_NAME}"

# --- Semantic-feature ablation study: OFF by default on the short pipeline ---
# It re-embeds the entire cohort once PER spec (5 specs) and will likely exceed
# the 9h wall. Set to 1 to run it (this also re-enables ablation_runner in the
# analysis job). Note: the ablated narratives must already exist for their specs.
RUN_ABLATIONS=0
