# =============================================================================
# short_pipeline overrides
# -----------------------------------------------------------------------------
# Sourced by EVERY slurm_jobs/short_pipeline/*.sbatch AFTER the real .env, with
# `set -a` so these EXPORT and win over the .env values in the shell. Every
# load_dotenv() in this repo uses override=False, so Python keeps these once set.
#
# This IS the main pipeline, unchanged in substance -- same cohort, same real
# artifacts/ tree -- just run on the c3_short partition (9h wall) because
# c3_accel's GPUs are busy with the neighbor-judging run. LLM judging is OFF
# here (it cannot clear a 9h wall). Outputs land in the SAME artifacts/
# locations as a normal run; separation from the live 8B run comes from the
# DIFFERENT encoder name -- embeddings.db and results are keyed by
# EMBEDDER_MODEL_NAME -- while the model-independent narratives and feature
# parquet are shared (deterministic, identical content).
# =============================================================================

# --- Force LLM judging + the extra (non-nearest) neighbor schemes off ---
COMPUTE_LLM_SIMILARITY=0
NEIGHBOR_FARTHEST=0
NEIGHBOR_SUBSAMPLE=0

# --- Encoder model: ---
EMBEDDER_MODEL_NAME="Qwen-Qwen3-Embedding-4B"
EMBEDDER_MODEL_PATH="${ANALYSIS_DIR}/models/${EMBEDDER_MODEL_NAME}"
# NARRATIVES_DIR and FEATURE_DATAFRAME_PATH intentionally inherit the real .env
# values -- narratives and the feature parquet are model-independent and shared.
EMBEDDINGS_DIR="${ARTIFACTS_DIR}/${EMBEDDER_MODEL_NAME}"
RESULTS_DIR="${ARTIFACTS_DIR}/${EMBEDDER_MODEL_NAME}/${VLLM_MODEL_NAME}"

# --- Semantic-feature ablation study: ON (re-embeds the cohort once per spec) ---
RUN_ABLATIONS=1
