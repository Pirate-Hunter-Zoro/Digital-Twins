# Random seed for reproducibility
SEED=42

# Loading, creating, and cleaning patient data
PREP_DATA_DIR="/media/studies/ehr_study/data-EHR-prepped/DV250901v1-PV250918v1/PrepData-25_09_10/"
PROCEDURE_CSV_PATH="/media/studies/ehr_study/data-EHR-prepped/DV250901v1-PV250918v1/PrepData-25_09_10/Procedure_Table-25_09_10-v1.csv"
MEDICATION_CSV_PATH="/media/studies/ehr_study/data-EHR-prepped/DV250901v1-PV250918v1/PrepData-25_09_10/Medication_Table-25_09_10-v1.csv"
DIAGNOSIS_CSV_PATH="/media/studies/ehr_study/data-EHR-prepped/DV250901v1-PV250918v1/PrepData-25_09_10/Diagnosis_Table-25_09_10-v1.csv"
ENCOUNTER_CSV_PATH="/media/studies/ehr_study/data-EHR-prepped/DV250901v1-PV250918v1/PrepData-25_09_10/Encounter_Table-25_09_10-v1.csv"
PERSON_CSV_PATH="/media/studies/ehr_study/data-EHR-prepped/DV250901v1-PV250918v1/PrepData-25_09_10/Person_Table-25_09_10-v1.csv"
PATIENT_JSON_DIR="/media/studies/ehr_study/analysis/mferguson/patient_json"
SLICED_PATIENT_JSON_DIR="/media/studies/ehr_study/analysis/mferguson/sliced_patient_json"
COHORT_PATH="/media/studies/ehr_study/analysis/mferguson/mdd_only_patients.csv"

# Embedding model to use
EMBEDDER_MODEL_PATH="/media/studies/ehr_study/analysis/mferguson/models/Qwen-Qwen3-Embedding-8B"
EMBEDDER_MODEL_NAME="Qwen-Qwen3-Embedding-8B"
EMBEDDER_DEVICE="cpu" # Bear in mind that changing to 'cuda' tends to lead to running out of VRAM when trying to embed large strings with the GPU, and reserving multiple GPUs does not help because the SentenceTransformer does not know how to use both together
EMBEDDER_BATCH_SIZE=32 # How many strings we feed into the embedder at once for it to return a corresponding list of vectors

# Generative model to use
VLLM_MODEL_PATH="/media/studies/ehr_study/analysis/mferguson/models/google_medgemma-27b-text-it"
VLLM_URL="http://compute306:8000"
PATIENT_JSON_CHUNK_SIZE=32768 # How many characters allowed in one patient chunk of data to produce a narrative for (rolling strategy in case of large patient record)
MAX_TOKENS=8192 # Maximum number of tokens allowed in response

# Storage of computed narratives, vectors, analysis values, and logs
NARRATIVES_DIR="artifacts/narratives/"
VECTORS_DIR="artifacts/vectors/"
ANALYSIS_DIR="artifacts/analysis/"

# Concurrency hyperparameters - beware of overwhelming the vllm server...
NUM_WORKERS_NON_LLM_TASK=16
NUM_WORKERS_LLM_TASK=2

# Hyperparameters for analysis of judge similarity versus embedding cosine similarity
NUM_PATIENTS=1000
YEARS_BACK=2
NUM_PAIRS=10000
DISCORDANT_LOW_PERCENTILE=25
DISCORDANT_HIGH_PERCENTILE=75