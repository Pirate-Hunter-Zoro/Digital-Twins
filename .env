# Random seed for reproducibility
SEED=42

# Loading, creating, and cleaning patient data
PREP_DATA_DIR="/media/studies/ehr_study/data-EHR-prepped/DV250901v1-PV251208v1/PrepData/"
PROCEDURE_CSV_PATH="/media/studies/ehr_study/data-EHR-prepped/DV250901v1-PV251208v1/PrepData/Procedure_Table.csv"
MEDICATION_CSV_PATH="/media/studies/ehr_study/data-EHR-prepped/DV250901v1-PV251208v1/PrepData/Medication_Table.csv"
DIAGNOSIS_CSV_PATH="/media/studies/ehr_study/data-EHR-prepped/DV250901v1-PV251208v1/PrepData/Diagnosis_Table.csv"
ENCOUNTER_CSV_PATH="/media/studies/ehr_study/data-EHR-prepped/DV250901v1-PV251208v1/PrepData/Encounter_Table.csv"
PERSON_CSV_PATH="/media/studies/ehr_study/data-EHR-prepped/DV250901v1-PV251208v1/PrepData/Person_Table.csv"
TRD_LIST_PATH="media/studies/ehr_study/data-EHR-prepped/DV250901v1-PV251208v1/OutputData/IDs-TRD.txt"
ANALYSIS_DIR="/media/studies/ehr_study/analysis/mferguson/"
MDD_MED_DATE_CSV_PATH="${ANALYSIS_DIR}/post_mdd_ad_index.csv"
PATIENT_JSON_DIR="${ANALYSIS_DIR}/patient_json"
SLICED_PATIENT_JSON_DIR="${ANALYSIS_DIR}/sliced_patient_json"
UNSLICED_PATIENT_JSON_DIR="${ANALYSIS_DIR}/unsliced_patient_json"
COHORT_PATH="${ANALYSIS_DIR}/mdd_only_patients.csv"

# Embedding model to use
EMBEDDER_MODEL_NAME="Qwen-Qwen3-Embedding-8B"
EMBEDDER_MODEL_PATH="${ANALYSIS_DIR}/models/${EMBEDDER_MODEL_NAME}"
EMBEDDER_DEVICE="cpu" # Bear in mind that changing to 'cuda' tends to lead to running out of VRAM when trying to embed large strings with the GPU, and reserving multiple GPUs does not help because the SentenceTransformer does not know how to use both together
EMBEDDER_BATCH_SIZE=32 # How many strings we feed into the embedder at once for it to return a corresponding list of vectors

# Generative model to use
VLLM_MODEL_NAME="google_medgemma-27b-text-it"
VLLM_MODEL_PATH="${ANALYSIS_DIR}/models/${VLLM_MODEL_NAME}"
VLLM_URL="http://compute306:8000"
PATIENT_JSON_CHUNK_SIZE=32768 # How many characters allowed in one patient chunk of data to produce a narrative for (rolling strategy in case of large patient record)
MAX_TOKENS=8192 # Maximum number of tokens allowed in response

# Storage of computed narratives, vectors, analysis values, and logs
ARTIFACTS_DIR="${ANALYSIS_DIR}/artifacts/"
LLM_NARRATIVES_DIR="${ARTIFACTS_DIR}/${VLLM_MODEL_NAME}/llm_narratives/"
SCRUB_VECTORS=0
DETERMINISTIC_NARRATIVES_DIR="${ARTIFACTS_DIR}/deterministic_narratives/"
VECTORS_DIR="${ARTIFACTS_DIR}/${EMBEDDER_MODEL_NAME}/"
JUDGEMENTS_DIR="${ARTIFACTS_DIR}/${VLLM_MODEL_NAME}/"

# Concurrency hyperparameters - beware of overwhelming the vllm server...
NUM_WORKERS_NON_LLM_TASK=16
NUM_WORKERS_LLM_TASK=2

# Hyperparameters for patient parsing and number of digital twins
NUM_NEIGHBOR_PATIENTS=200
YEARS_BACK=2
YEARS_FORWARD=2