# Random seed for reproducibility
SEED=42

# Loading, creating, and cleaning patient data
PREP_DATA_DIR="/media/studies/ehr_study/data-EHR-prepped/DV250901v1-PV251208v1/PrepData"
OUTPUT_DATA_DIR="/media/studies/ehr_study/data-EHR-prepped/DV250901v1-PV251208v1/OutputData"
PROCEDURE_CSV_PATH="${PREP_DATA_DIR}/Procedure_Table.csv"
MEDICATION_CSV_PATH="${PREP_DATA_DIR}/Medication_Table.csv"
DIAGNOSIS_CSV_PATH="${PREP_DATA_DIR}/Diagnosis_Table.csv"
ENCOUNTER_CSV_PATH="${PREP_DATA_DIR}/Encounter_Table.csv"
VITALS_CSV_PATH="${PREP_DATA_DIR}/Vitals_Table.csv"
PERSON_CSV_PATH="${PREP_DATA_DIR}/Person_Table.csv"
TRD_LIST_PATH="${OUTPUT_DATA_DIR}/IDs-TRD.txt"
ANALYSIS_DIR="/media/studies/ehr_study/analysis/mferguson"
MDD_MED_DATE_CSV_PATH="${ANALYSIS_DIR}/post_mdd_ad_index.csv"
PATIENT_JSON_DIR="${ANALYSIS_DIR}/patient_json"
SLICED_PATIENT_JSON_DIR="${ANALYSIS_DIR}/sliced_patient_json"
COHORT_PATH="${ANALYSIS_DIR}/mdd_only_patients.csv"

# HuggingFace cache
HF_HOME="${ANALYSIS_DIR}/models/hf_cache"

# Embedding model to use
EMBEDDER_MODEL_NAME="Qwen-Qwen3-Embedding-8B"
EMBEDDER_MODEL_PATH="${ANALYSIS_DIR}/models/${EMBEDDER_MODEL_NAME}"
EMBEDDER_DEVICE="cuda" # Bear in mind that 'cuda' tends to lead to running out of VRAM when trying to embed large strings with the GPU, and reserving multiple GPUs does not help because the SentenceTransformer does not know how to use both together - use 'cpu' in that case
EMBEDDER_BATCH_SIZE=32 # How many strings we feed into the embedder at once for it to return a corresponding list of vectors

# Generative model to use
VLLM_MODEL_NAME="google_medgemma-27b-text-it"
VLLM_MODEL_PATH="${ANALYSIS_DIR}/models/${VLLM_MODEL_NAME}"
MAX_MODEL_LEN=32768
PATIENT_JSON_CHUNK_SIZE=${MAX_MODEL_LEN} # How many characters allowed in one patient chunk of data to produce a narrative for (rolling strategy in case of large patient record)
MAX_TOKENS=8192 # Maximum number of tokens allowed in response

# Storage of computed narratives, vectors, analysis values, and logs
ARTIFACTS_DIR="${ANALYSIS_DIR}/artifacts"
SCRUB_PATIENT_JSON=0
SCRUB_NARRATIVES=0
SCRUB_FEATURE_VECTORS=0
SCRUB_EMBEDDINGS=0
SCRUB_TRAINED_MODELS=0
NARRATIVES_DIR="${ARTIFACTS_DIR}/deterministic_narratives"
FEATURE_DATAFRAME_PATH="${ARTIFACTS_DIR}/deterministic_vectors.parquet"
EMBEDDINGS_DIR="${ARTIFACTS_DIR}/${EMBEDDER_MODEL_NAME}"
JUDGEMENTS_DIR="${ARTIFACTS_DIR}/${VLLM_MODEL_NAME}"
RESULTS_DIR="${ARTIFACTS_DIR}/${EMBEDDER_MODEL_NAME}/${VLLM_MODEL_NAME}"

# Concurrency hyperparameters - beware of overwhelming the vllm server...
NUM_WORKERS_NON_LLM_TASK=16
NUM_WORKERS_LLM_TASK=16

# Hyperparameters for patient parsing and number of digital twins
YEARS_BACK=2
YEARS_AHEAD=1
# Maximum days of history allowed to show up in a histogram of chronological lengths
HISTORY_LENGTH_CUTOFF=5000 
# Total number of neighbors we look at for risk score calculation
NUM_NEIGHBOR_PATIENTS=50 
# Total number of random neighbors we pick fo the subsampling method
SUBSAMPLE_POOL_SIZE=200 
HIGH_SIM_THRESHOLD=0.95
LOW_CONFIDENCE_ESS_THRESHOLD=20
NUM_PAIRS_SANITY_CHECK=1000
WEIGHTING_EXPONENT=5.0
TRD_TEST_COUNT=1000

# Hyperparameters pertaining to querying VLLM server
VLLM_URL=http://compute306:8000
COMPUTE_LLM_SIMILARITY=0 # Whether we actually compute 
NEIGHBOR_FARTHEST=0 # Whether we compute the KNN weighting scheme via farthest neighbors
NEIGHBOR_SUBSAMPLE=0 # Whether we compute the KNN weighting scheme via a subsample method